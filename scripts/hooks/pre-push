#!/usr/bin/env bash
# pre-push 门禁：master 只允许从部署树 /opt/nox 推送。
# 库卫生小包（10-19）：远端名闸——本仓唯一远端=nox（origin 不存在）；
# 裸 `git push origin` 曾静默吞件（6f4a396→cherry-pick 6407ec0 回补）。
# 能走到本 hook 的推送（远端可解析）一律校验远端名，错名=显式失败指路。
set -u

remote="$1"

case "$remote" in
    nox)
        ;;
    *)
        echo "FAIL: 推送远端必须是 nox（本仓唯一远端；'$remote' 非法）——统一走 scripts/git_push.sh" >&2
        exit 1
        ;;
esac

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/master" ] || continue
    # B④ 红查真漏同修：refspec 变形面 fail-open——+force 前缀/全零 sha
    # （remote 删除 master）原两查全过=放行；变形禁绝于源。
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        echo "FAIL: 远端删除 refs/heads/master 禁绝（pre-push 闸——变形 refspec 面）" >&2
        exit 1
    fi
    case "$local_ref" in
        +*|refs/tags/*|*:*) echo "FAIL: master 推送禁 refspec 变形（force/映射/tag）——refs/heads/<branch> 直推" >&2; exit 1 ;;
    esac
    repo="$(git rev-parse --show-toplevel 2>/dev/null || echo "${GIT_DIR:-unknown}")"
    case "$repo" in
        /opt/nox)
            exit 0
            ;;
        *)
            echo "FAIL: master 只能从部署树 /opt/nox 推送；工作分支请推 wip/<票名>" >&2
            exit 1
            ;;
    esac
done

exit 0
